DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Keep false for local HTTP. See docs/security/hardening.md for production.
DJANGO_HTTPS_ENABLED=False
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_LOGIN_FAILURE_LIMIT=5
DJANGO_LOGIN_COOLOFF_MINUTES=15

# Optional fine-grained overrides. HTTPS_ENABLED already selects safe defaults.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

POSTGRES_DB=replenish_agent
POSTGRES_USER=replenish_agent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=30

MISTRAL_API_KEY=
MISTRAL_MODEL=
